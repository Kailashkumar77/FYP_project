# Environment Variables Template for IntelliCRM AI
# Copy to .env and configure for local development

# Environment
APP_ENV=development
DEBUG=True
SECRET_KEY=intellicrm-super-secret-development-key-change-in-prod-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=intellicrm_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/intellicrm_db
# For SQLite fallback during local development/testing without docker:
# DATABASE_URL=sqlite+aiosqlite:///./intellicrm.db

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Email Configuration (Mocked to console in local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=notifications@intellicrm.ai
EMAILS_FROM_NAME="IntelliCRM AI"

# Frontend Public Config
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
